# Required local model directories. This project does not download models.
LLM_MODEL_PATH=/path/to/Qwen2.5-7B-Instruct
EMBEDDING_MODEL_PATH=/path/to/bge-m3

# Optional local CrossEncoder (for example a BGE reranker). If empty, local
# RAG still uses dense + BM25 + RRF but does not claim reranking.
RERANKER_MODEL_PATH=

# Optional. Leave empty to connect directly.
WEB_PROXY=

# Optional. Anonymous GitHub API requests have a lower rate limit.
GITHUB_TOKEN=

# Optional. OpenAlex fallback does not require an API key.
SEMANTIC_SCHOLAR_API_KEY=

# Optional contact email for the OpenAlex polite pool.
OPENALEX_MAILTO=

# Persistent state on the Linux server. Relative paths are resolved from the
# process working directory; absolute server paths are also accepted.
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
MEMORY_DB_PATH=data/memory.sqlite

# Optional human approval before retrieval. CLI supports resume directly.
REQUIRE_PLAN_APPROVAL=false

# Maximum conversation characters loaded into short-term context.
MAX_CONTEXT_CHARS=12000

# Local RAG parent-child chunking and Reciprocal Rank Fusion.
RAG_PARENT_CHUNK_SIZE=1800
RAG_PARENT_CHUNK_OVERLAP=200
RAG_CHILD_CHUNK_SIZE=450
RAG_CHILD_CHUNK_OVERLAP=80
RAG_RRF_K=60

# Opt-in long-term memory. Episodic summaries expire; explicit preferences do not.
MEMORY_RECALL_LIMIT=5
MEMORY_TTL_DAYS=180

# Academic PDF parsing. Tables are extracted with PyMuPDF. OCR is disabled by
# default; tesseract mode requires the Tesseract binary and language data on Linux.
PDF_EXTRACT_TABLES=true
PDF_MIN_TEXT_CHARS=80
PDF_MAX_PAGES=500
PDF_MAX_FILE_MB=200
PDF_OCR_MODE=disabled
PDF_OCR_LANGUAGE=eng
